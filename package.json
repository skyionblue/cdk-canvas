{
  "name": "cdk-canvas",
  "version": "0.0.0",
  "private": true,
  "description": "CDK-Canvas - Interactive CDK Diagram Designer",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "prebuild": "prettier --check . && eslint .",
    "test": "pnpm -r run test",
    "start": "node packages/cdk-canvas/bin/cdk-canvas.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
