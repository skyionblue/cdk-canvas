{
  "name": "@skyionblue/cdk-canvas",
  "version": "0.2.7",
  "description": "Interactive CDK diagram designer - CLI and server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cdk-canvas": "./bin/cdk-canvas.js"
  },
  "files": [
    "bin",
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "vite build && tsc",
    "dev:server": "tsc --watch",
    "dev:frontend": "vite",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "prebuild": "prettier --check . && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node bin/cdk-canvas.js"
  },
  "keywords": [
    "aws",
    "cdk",
    "diagram",
    "visualization",
    "infrastructure"
  ],
  "author": "TrueMark",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/cors": "^2.8.0",
    "@types/dagre": "^0.7.54",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.2.0",
    "dagre": "^0.8.5",
    "eslint": "^9.0.0",
    "html-to-image": "^1.11.13",
    "prettier": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.10.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.1.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
